function resultStruct = calcRtError(resultStruct, Rt_hist_true, time_hist_true)

    methodsUsed = fieldnames(resultsStruct);

    for m = 1: length(methodsUsed)

        methodName = methodsUsed{m};
        
        currentTime = resultsStruct.(methodName).time(1,end);

        index_Rt_true = find(time_hist_true == currentTime);


        



end